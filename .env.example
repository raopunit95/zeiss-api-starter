# Copy to .env (gitignored) and fill in. Never commit .env.
HOST=127.0.0.1
PORT=3000

# Hospital list API credentials
INVENTORY_SOURCE=
INVENTORY_XPI=

# Where appointment requests are sent.
# Option 1: n8n webhook directly
WEBHOOK_ALLOW_DIRECT_N8N=true
WEBHOOK_URL=https://n8n-public.medibuddy.in/webhook/<uuid>
# Only if the n8n Webhook node uses Header Auth:
# WEBHOOK_AUTH_HEADER=
# WEBHOOK_AUTH_VALUE=

# Option 2: gateway route (leave ALLOW_DIRECT unset and set all four)
# WEBHOOK_URL=https://api-external.medibuddy.in/w/<route>
# WEBHOOK_GATEWAY_KEY=
# WEBHOOK_AUTH_HEADER=
# WEBHOOK_AUTH_VALUE=

# Optional
# STORES_FILE=<absolute path to a stores.json>
# TRUST_PROXY=1   # set when running behind a load balancer / reverse proxy
