# Copy to .env (gitignored) and fill in. NEVER commit .env.
APP_MODE=api-preview
HOST=127.0.0.1
PORT=3000

# Inventory API credentials (from your secure channel)
INVENTORY_SOURCE=
INVENTORY_XPI=

# --- Webhook (synthetic test data only) ---
# To send to the n8n webhook, change APP_MODE to api-webhook and fill these in:
# APP_MODE=api-webhook
# WEBHOOK_SYNTHETIC_ONLY=true
# WEBHOOK_ALLOW_DIRECT_N8N=true
# WEBHOOK_URL=https://n8n-public.medibuddy.in/webhook/<your-uuid>
# Optional, only if the n8n Webhook node has Header Auth enabled:
# WEBHOOK_AUTH_HEADER=
# WEBHOOK_AUTH_VALUE=

# Gateway route instead (api-external.medibuddy.in/w/...): leave ALLOW_DIRECT off and set all four:
# WEBHOOK_URL=https://api-external.medibuddy.in/w/<route>
# WEBHOOK_GATEWAY_KEY=
# WEBHOOK_AUTH_HEADER=
# WEBHOOK_AUTH_VALUE=

# Optional
# STORES_FILE=<absolute path to stores.json>
# DEMO_REQUESTS_FILE=<absolute path to demo JSONL>
